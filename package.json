  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/compiler-sfc": "3.5.13",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "10.6.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.1",
    "localStorage": "1.0.4",
    "prettier": "3.9.7",
    "sass": "1.104.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-eslint-parser": "10.4.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10"
  },
  "lint-staged": {
    "*.{js,vue}": "eslint --cache"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "canvas@3.2.3": true,
    "core-js": false,
    "fsevents": false,
    "vue-demi": false
  }
}
