    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/multimonth": "6.1.21",
    "@fullcalendar/vue3": "6.1.21",
    "@google/model-viewer": "4.3.1",
    "@sentry/vue": "10.74.0",
    "@unhead/vue": "3.4.1",
    "@vuepic/vue-datepicker": "14.0.0",
    "autosize": "6.0.1",
    "bowser": "2.14.1",
    "bulma": "0.3.1",
    "chart.js": "4.5.1",
    "chartkick": "5.0.1",
    "color": "5.0.3",
    "color-hash": "2.0.2",
    "core-js": "3.50.0",
    "date-fns": "4.4.0",
    "diff2html": "3.4.56",
    "exceljs": "4.4.0",
    "fabric": "7.4.0",
    "fabricjs-psbrush": "cgwire/fabricjs-psbrush",
    "lucide-vue-next": "0.577.0",
    "marked": "18.0.13",
    "marked-emoji": "3.0.0",
    "moment": "2.31.0",
    "moment-timezone": "0.6.4",
    "panzoom": "9.4.4",
    "papaparse": "5.7.0",
    "qrcode.vue": "3.11.0",
    "sanitize-html": "2.17.7",
    "socket.io-client": "4.8.3",
    "superagent": "10.3.0",
    "thenby": "1.4.1",
    "three": "0.186.0",
    "uuid": "14.0.2",
    "vue": "3.5.13",
    "vue-3-slider-component": "1.0.2",
    "vue-at": "3.0.0-alpha.3",
    "vue-chartkick": "1.1.0",
    "vue-i18n": "9.14.5",
    "vue-multiselect": "3.5.0",
    "vue-router": "5.3.1",
